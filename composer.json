{
    "name": "wanli/wanli-v2",
    "type": "project",
    "description": "万利云赏 · 知识付费系统重写 (Hyperf 3.1, R0)",
    "keywords": ["php", "swoole", "hyperf", "video", "payment", "kyc"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10",
        "hyperf/async-queue": "^3.1",
        "hyperf/cache": "^3.1",
        "hyperf/command": "^3.1",
        "hyperf/config": "^3.1",
        "hyperf/contract": "^3.1",
        "hyperf/crontab": "^3.1",
        "hyperf/database": "^3.1",
        "hyperf/db-connection": "^3.1",
        "hyperf/di": "^3.1",
        "hyperf/event": "^3.1",
        "hyperf/filesystem": "^3.1",
        "hyperf/framework": "^3.1",
        "hyperf/guzzle": "^3.1",
        "hyperf/helper": "^3.1",
        "hyperf/http-server": "^3.1",
        "hyperf/logger": "^3.1",
        "hyperf/model-cache": "^3.1",
        "hyperf/paginator": "^3.1",
        "hyperf/process": "^3.1",
        "hyperf/redis": "^3.1",
        "hyperf/session": "^3.1",
        "hyperf/utils": "^3.1",
        "hyperf/validation": "^3.1",
        "hyperf/view": "^3.1",
        "hyperf/view-engine": "^3.1"
    },
    "require-dev": {
        "hyperf/devtool": "^3.1",
        "hyperf/testing": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "./test/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-autoload-dump": [
            "rm -rf runtime/container"
        ],
        "test": "co-phpunit -c phpunit.xml --colors=always",
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php ./bin/hyperf.php start"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
